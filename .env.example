# Copy this file to .env and edit it locally. Never commit a real API key.
# Reuse an existing key from a Gemini Developer API project on the Free tier.
GEMINI_API_KEY=

# Successful connection test on 2026-11-15; free input/output listed by Google.
# Verify this model's availability and free-tier quota in your own AI Studio project.
GEMINI_MODEL=gemini-3.6-flash
